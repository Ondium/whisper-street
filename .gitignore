# force-added (git add -f). Everything else stays out of git.
*.wav
*.mp3
*.m4a
*.flac
*.ogg
*.opus
*.mp4
*.mkv
*.webm
!tests/fixtures/**
out/
output/
transcripts/
*.srt
*.vtt
!docs/**/*.srt
!docs/**/*.vtt

